@page "/administracion-smt"
@rendermode InteractiveServer
@inject SmtAdministrationService SmtService

<PageTitle>Administracion SMT</PageTitle>

<section class="planner-shell">
    <div class="planner-header">
        <div>
            <p class="eyebrow">SMT</p>
            <h1>Administracion SMT</h1>
        </div>
        <div class="scenario-pill">
            <span>Registros SMT</span>
            <strong>@TotalRecords.ToString("N0")</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @StatusClass" role="alert">@StatusMessage</div>
    }

    @if (IsLoading)
    {
        <div class="panel">Cargando administracion SMT...</div>
    }
    else if (Snapshot is null)
    {
        <div class="alert alert-danger">No pude cargar la administracion SMT.</div>
    }
    else
    {
        <div class="catalog-tabs">
            @foreach (var tab in Tabs)
            {
                <button class="@GetTabClass(tab.Key)" type="button" @onclick="() => ActiveTab = tab.Key">
                    @tab.Label
                </button>
            }
        </div>

        @switch (ActiveTab)
        {
            case "families":
                @FamilySection()
                break;
            case "family-rates":
                @FamilyRateSection()
                break;
            case "line-rates":
                @LineRateSection()
                break;
            case "line-assignments":
                @LineAssignmentSection()
                break;
            case "calendar":
                @OperationCapacitySection()
                break;
            case "targets":
                @CapacityTargetSection()
                break;
            case "audit":
                @AuditSection()
                break;
        }
    }
</section>

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("families", "Familias SMT"),
        ("family-rates", "UPH por familia"),
        ("line-rates", "UPH por linea"),
        ("line-assignments", "Distribucion por linea"),
        ("calendar", "Calendario SMT"),
        ("targets", "Targets Capacity SMT"),
        ("audit", "Historial SMT")
    ];

    private bool IsLoading { get; set; } = true;
    private string ActiveTab { get; set; } = "families";
    private SmtAdministrationSnapshot? Snapshot { get; set; }
    private string? StatusMessage { get; set; }
    private string StatusClass { get; set; } = "alert-success";
    private SmtFamilyCatalogItem FamilyForm { get; set; } = NewFamily();
    private SmtFamilyRateCatalogItem FamilyRateForm { get; set; } = NewFamilyRate();
    private SmtLineFamilyRateCatalogItem LineRateForm { get; set; } = NewLineRate();
    private SmtLineAssignmentCatalogItem LineAssignmentForm { get; set; } = NewLineAssignment();
    private SmtOperationCapacityCatalogItem OperationCapacityForm { get; set; } = NewOperationCapacity();
    private SmtCapacityTargetCatalogItem CapacityTargetForm { get; set; } = NewCapacityTarget();
    private string FamilySearchText { get; set; } = string.Empty;
    private string FamilyRateSearchText { get; set; } = string.Empty;
    private string LineRateSearchText { get; set; } = string.Empty;
    private string LineAssignmentSearchText { get; set; } = string.Empty;
    private string OperationCapacitySearchText { get; set; } = string.Empty;
    private string CapacityTargetSearchText { get; set; } = string.Empty;
    private string AuditSearchText { get; set; } = string.Empty;
    private SmtFamilyCatalogSortColumn FamilySortColumn { get; set; } = SmtFamilyCatalogSortColumn.ProductFamily;
    private SmtFamilyRateCatalogSortColumn FamilyRateSortColumn { get; set; } = SmtFamilyRateCatalogSortColumn.ProductFamily;
    private SmtLineFamilyRateCatalogSortColumn LineRateSortColumn { get; set; } = SmtLineFamilyRateCatalogSortColumn.ProductFamily;
    private SmtLineAssignmentCatalogSortColumn LineAssignmentSortColumn { get; set; } = SmtLineAssignmentCatalogSortColumn.ProductFamily;
    private SmtOperationCapacityCatalogSortColumn OperationCapacitySortColumn { get; set; } = SmtOperationCapacityCatalogSortColumn.WeekName;
    private SmtCapacityTargetCatalogSortColumn CapacityTargetSortColumn { get; set; } = SmtCapacityTargetCatalogSortColumn.ProductFamily;
    private SmtAuditLogSortColumn AuditSortColumn { get; set; } = SmtAuditLogSortColumn.CreatedAtUtc;
    private bool FamilySortDescending { get; set; }
    private bool FamilyRateSortDescending { get; set; }
    private bool LineRateSortDescending { get; set; }
    private bool LineAssignmentSortDescending { get; set; }
    private bool OperationCapacitySortDescending { get; set; }
    private bool CapacityTargetSortDescending { get; set; }
    private bool AuditSortDescending { get; set; } = true;

    private int TotalRecords => Snapshot is null
        ? 0
        : Snapshot.Families.Count + Snapshot.FamilyRates.Count + Snapshot.LineFamilyRates.Count + Snapshot.LineAssignments.Count + Snapshot.OperationCapacities.Count + Snapshot.CapacityTargets.Count;
    private IReadOnlyList<SmtFamilyCatalogItem> FilteredFamilies => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyFamilies(Snapshot.Families, FamilySearchText, FamilySortColumn, FamilySortDescending);
    private IReadOnlyList<SmtFamilyRateCatalogItem> FilteredFamilyRates => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyFamilyRates(Snapshot.FamilyRates, FamilyRateSearchText, FamilyRateSortColumn, FamilyRateSortDescending);
    private IReadOnlyList<SmtLineFamilyRateCatalogItem> FilteredLineRates => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyLineRates(Snapshot.LineFamilyRates, LineRateSearchText, LineRateSortColumn, LineRateSortDescending);
    private IReadOnlyList<SmtLineAssignmentCatalogItem> FilteredLineAssignments => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyLineAssignments(Snapshot.LineAssignments, LineAssignmentSearchText, LineAssignmentSortColumn, LineAssignmentSortDescending);
    private IReadOnlyList<SmtOperationCapacityCatalogItem> FilteredOperationCapacities => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyOperationCapacities(Snapshot.OperationCapacities, OperationCapacitySearchText, OperationCapacitySortColumn, OperationCapacitySortDescending);
    private IReadOnlyList<SmtCapacityTargetCatalogItem> FilteredCapacityTargets => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyCapacityTargets(Snapshot.CapacityTargets, CapacityTargetSearchText, CapacityTargetSortColumn, CapacityTargetSortDescending);
    private IReadOnlyList<SmtAuditLogItem> FilteredAuditLogs => Snapshot is null
        ? []
        : SmtAdministrationTableQuery.ApplyAuditLogs(Snapshot.AuditLogs, AuditSearchText, AuditSortColumn, AuditSortDescending);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadSnapshotAsync();
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = $"No pude cargar Administracion SMT. Verifica que el script 010 este aplicado en SQL Server: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadSnapshotAsync()
    {
        Snapshot = await SmtService.GetSnapshotAsync();
        EnsureDefaults();
    }

    private void EnsureDefaults()
    {
        if (Snapshot is null)
        {
            return;
        }

        if (FamilyRateForm.OperationId == 0)
        {
            FamilyRateForm.OperationId = DefaultOperationId();
        }

        if (LineRateForm.OperationId == 0)
        {
            LineRateForm.OperationId = DefaultOperationId();
        }

        if (LineAssignmentForm.ScenarioId == 0)
        {
            LineAssignmentForm.ScenarioId = DefaultScenarioId();
        }

        if (LineAssignmentForm.ProductionWeekId == 0)
        {
            LineAssignmentForm.ProductionWeekId = DefaultWeekId(LineAssignmentForm.ScenarioId);
        }

        if (LineAssignmentForm.OperationId == 0)
        {
            LineAssignmentForm.OperationId = DefaultOperationId();
        }

        if (OperationCapacityForm.ScenarioId == 0)
        {
            OperationCapacityForm.ScenarioId = DefaultScenarioId();
        }

        if (OperationCapacityForm.ProductionWeekId == 0)
        {
            OperationCapacityForm.ProductionWeekId = DefaultWeekId(OperationCapacityForm.ScenarioId);
        }

        if (OperationCapacityForm.OperationId == 0)
        {
            OperationCapacityForm.OperationId = DefaultOperationId();
        }

        if (CapacityTargetForm.ScenarioId == 0)
        {
            CapacityTargetForm.ScenarioId = DefaultScenarioId();
        }

        if (CapacityTargetForm.ProductionWeekId == 0)
        {
            CapacityTargetForm.ProductionWeekId = DefaultWeekId(CapacityTargetForm.ScenarioId);
        }

        if (CapacityTargetForm.OperationId == 0)
        {
            CapacityTargetForm.OperationId = DefaultOperationId();
        }

        if (string.IsNullOrWhiteSpace(FamilyRateForm.ProductFamily))
        {
            FamilyRateForm.ProductFamily = DefaultFamily();
        }

        if (string.IsNullOrWhiteSpace(LineRateForm.ProductFamily))
        {
            LineRateForm.ProductFamily = DefaultFamily();
        }

        if (string.IsNullOrWhiteSpace(LineAssignmentForm.ProductFamily))
        {
            LineAssignmentForm.ProductFamily = DefaultFamily();
        }

        if (string.IsNullOrWhiteSpace(CapacityTargetForm.ProductFamily))
        {
            CapacityTargetForm.ProductFamily = DefaultFamily();
        }
    }

    private RenderFragment FamilySection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Familias SMT</h2>
            <span>@FilteredFamilies.Count de @Snapshot!.Families.Count registros</span>
        </div>
        <p class="muted-cell">Da de alta familias como AZTECA o BLACK BOLT. Los numeros de parte pueden seguir viviendo en Productos, pero SMT se planea por familia.</p>
        <div class="control-grid">
            <label><span>Buscar en catalogo</span><InputText class="form-control" @bind-Value="FamilySearchText" /></label>
        </div>
        <EditForm Model="FamilyForm" OnValidSubmit="SaveFamilyAsync">
            <div class="catalog-form">
                <label><span>Familia</span><InputText class="form-control" @bind-Value="FamilyForm.ProductFamily" /></label>
                <label><span>BU</span><InputText class="form-control" @bind-Value="FamilyForm.BusinessUnit" /></label>
                <label><span>Notas</span><InputText class="form-control" @bind-Value="FamilyForm.Notes" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="FamilyForm.IsActive" /> Activa</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetFamily">Nuevo</button>
                    @if (FamilyForm.SmtFamilyId > 0)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="ResetFamily">Cancelar edicion</button>
                    }
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>@SortableFamilyHeader("Familia", SmtFamilyCatalogSortColumn.ProductFamily)</th><th>@SortableFamilyHeader("BU", SmtFamilyCatalogSortColumn.BusinessUnit)</th><th>@SortableFamilyHeader("Numeros de parte", SmtFamilyCatalogSortColumn.PartNumberCount)</th><th>@SortableFamilyHeader("Estado", SmtFamilyCatalogSortColumn.IsActive)</th><th>Notas</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in FilteredFamilies)
                    {
                        <tr>
                            <td>@item.ProductFamily</td>
                            <td>@(item.BusinessUnit ?? "-")</td>
                            <td class="number-cell">@item.PartNumberCount.ToString("N0")</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td>@item.Notes</td>
                            <td><button class="link-button" type="button" @onclick="() => EditFamily(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment FamilyRateSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>UPH por familia</h2>
            <span>@FilteredFamilyRates.Count de @Snapshot!.FamilyRates.Count registros</span>
        </div>
        <p class="muted-cell">Captura el UPH base y cambios de modelo para cada familia SMT. Si hay un valor distinto por linea, se captura en UPH por linea.</p>
        <div class="control-grid">
            <label><span>Buscar en catalogo</span><InputText class="form-control" @bind-Value="FamilyRateSearchText" /></label>
        </div>
        <EditForm Model="FamilyRateForm" OnValidSubmit="SaveFamilyRateAsync">
            <div class="catalog-form">
                @FamilySelect("Familia", FamilyRateForm.ProductFamily, value => FamilyRateForm.ProductFamily = value)
                @OperationSelect(FamilyRateForm.OperationId, value => FamilyRateForm.OperationId = value)
                <label><span>UPH</span><DecimalInput Value="FamilyRateForm.UnitsPerHour" ValueChanged="value => FamilyRateForm.UnitsPerHour = value ?? 0m" /></label>
                <label><span>Cambios de modelo</span><DecimalInput Value="FamilyRateForm.ChangeoverCount" ValueChanged="value => FamilyRateForm.ChangeoverCount = value ?? 0m" /></label>
                <label><span>Parte fuente</span><InputText class="form-control" @bind-Value="FamilyRateForm.SourcePartNumber" /></label>
                <label><span>Bottleneck UPH</span><DecimalInput Value="FamilyRateForm.BottleneckUnitsPerHour" ValueChanged="value => FamilyRateForm.BottleneckUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Router UPH</span><DecimalInput Value="FamilyRateForm.RouterUnitsPerHour" ValueChanged="value => FamilyRateForm.RouterUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Wave UPH</span><DecimalInput Value="FamilyRateForm.WaveUnitsPerHour" ValueChanged="value => FamilyRateForm.WaveUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Pressfit UPH</span><DecimalInput Value="FamilyRateForm.PressfitUnitsPerHour" ValueChanged="value => FamilyRateForm.PressfitUnitsPerHour = value" AllowNull="true" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="FamilyRateForm.IsActive" /> Activo</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetFamilyRate">Nuevo</button>
                    @if (FamilyRateForm.SmtFamilyRateId > 0)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="ResetFamilyRate">Cancelar edicion</button>
                    }
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>@SortableFamilyRateHeader("Familia", SmtFamilyRateCatalogSortColumn.ProductFamily)</th><th>@SortableFamilyRateHeader("Operacion", SmtFamilyRateCatalogSortColumn.OperationCode)</th><th>@SortableFamilyRateHeader("UPH", SmtFamilyRateCatalogSortColumn.UnitsPerHour)</th><th>@SortableFamilyRateHeader("CO", SmtFamilyRateCatalogSortColumn.ChangeoverCount)</th><th>@SortableFamilyRateHeader("Parte fuente", SmtFamilyRateCatalogSortColumn.SourcePartNumber)</th><th>Bottleneck</th><th>Router</th><th>Wave</th><th>Pressfit</th><th>@SortableFamilyRateHeader("Estado", SmtFamilyRateCatalogSortColumn.IsActive)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in FilteredFamilyRates)
                    {
                        <tr>
                            <td>@item.ProductFamily</td>
                            <td>@item.OperationCode</td>
                            <td class="number-cell">@DecimalRounding.FormatNatural(item.UnitsPerHour, decimals: 2)</td>
                            <td class="number-cell">@DecimalRounding.FormatNatural(item.ChangeoverCount, decimals: 0)</td>
                            <td>@(item.SourcePartNumber ?? "-")</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.BottleneckUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.RouterUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.WaveUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.PressfitUnitsPerHour)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditFamilyRate(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment LineRateSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>UPH por linea SMT</h2>
            <span>@FilteredLineRates.Count de @Snapshot!.LineFamilyRates.Count registros</span>
        </div>
        <p class="muted-cell">Usa esta seccion solo cuando una familia tiene UPH distinto en una linea especifica.</p>
        <div class="control-grid">
            <label><span>Buscar en catalogo</span><InputText class="form-control" @bind-Value="LineRateSearchText" /></label>
        </div>
        <EditForm Model="LineRateForm" OnValidSubmit="SaveLineRateAsync">
            <div class="catalog-form">
                @FamilySelect("Familia", LineRateForm.ProductFamily, value => LineRateForm.ProductFamily = value)
                @OperationSelect(LineRateForm.OperationId, value => LineRateForm.OperationId = value)
                <label><span>Linea SMT</span><InputText class="form-control" @bind-Value="LineRateForm.LineCode" /></label>
                <label><span>Numero linea</span><InputNumber class="form-control" @bind-Value="LineRateForm.LineNumber" /></label>
                <label><span>UPH linea</span><DecimalInput Value="LineRateForm.UnitsPerHour" ValueChanged="value => LineRateForm.UnitsPerHour = value ?? 0m" /></label>
                <label><span>Parte fuente</span><InputText class="form-control" @bind-Value="LineRateForm.SourcePartNumber" /></label>
                <label><span>Bottleneck UPH</span><DecimalInput Value="LineRateForm.BottleneckUnitsPerHour" ValueChanged="value => LineRateForm.BottleneckUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Router UPH</span><DecimalInput Value="LineRateForm.RouterUnitsPerHour" ValueChanged="value => LineRateForm.RouterUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Wave UPH</span><DecimalInput Value="LineRateForm.WaveUnitsPerHour" ValueChanged="value => LineRateForm.WaveUnitsPerHour = value" AllowNull="true" /></label>
                <label><span>Pressfit UPH</span><DecimalInput Value="LineRateForm.PressfitUnitsPerHour" ValueChanged="value => LineRateForm.PressfitUnitsPerHour = value" AllowNull="true" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="LineRateForm.IsActive" /> Activo</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetLineRate">Nuevo</button>
                    @if (LineRateForm.SmtLineFamilyRateId > 0)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="ResetLineRate">Cancelar edicion</button>
                    }
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>@SortableLineRateHeader("Familia", SmtLineFamilyRateCatalogSortColumn.ProductFamily)</th><th>@SortableLineRateHeader("Operacion", SmtLineFamilyRateCatalogSortColumn.OperationCode)</th><th>@SortableLineRateHeader("Linea", SmtLineFamilyRateCatalogSortColumn.LineCode)</th><th>@SortableLineRateHeader("No.", SmtLineFamilyRateCatalogSortColumn.LineNumber)</th><th>@SortableLineRateHeader("UPH", SmtLineFamilyRateCatalogSortColumn.UnitsPerHour)</th><th>@SortableLineRateHeader("Parte fuente", SmtLineFamilyRateCatalogSortColumn.SourcePartNumber)</th><th>Bottleneck</th><th>Router</th><th>Wave</th><th>Pressfit</th><th>@SortableLineRateHeader("Estado", SmtLineFamilyRateCatalogSortColumn.IsActive)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in FilteredLineRates)
                    {
                        <tr>
                            <td>@item.ProductFamily</td>
                            <td>@item.OperationCode</td>
                            <td>@item.LineCode</td>
                            <td class="number-cell">@item.LineNumber</td>
                            <td class="number-cell">@DecimalRounding.FormatNatural(item.UnitsPerHour, decimals: 2)</td>
                            <td>@(item.SourcePartNumber ?? "-")</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.BottleneckUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.RouterUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.WaveUnitsPerHour)</td>
                            <td class="number-cell">@DecimalRounding.FormatOptionalUp(item.PressfitUnitsPerHour)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditLineRate(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment LineAssignmentSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Distribucion por linea</h2>
            <span>@FilteredLineAssignments.Count de @Snapshot!.LineAssignments.Count registros</span>
        </div>
        <p class="muted-cell">Captura que porcentaje de cada familia corre en cada linea SMT. Usa 100 para 100%, 50 para 50%, etc.</p>
        <div class="control-grid">
            <label><span>Buscar en catalogo</span><InputText class="form-control" @bind-Value="LineAssignmentSearchText" /></label>
        </div>
        <EditForm Model="LineAssignmentForm" OnValidSubmit="SaveLineAssignmentAsync">
            <div class="catalog-form">
                @ScenarioSelect(LineAssignmentForm.ScenarioId, SetLineAssignmentScenario)
                @WeekSelect(LineAssignmentForm.ProductionWeekId, LineAssignmentForm.ScenarioId, value => LineAssignmentForm.ProductionWeekId = value)
                @OperationSelect(LineAssignmentForm.OperationId, value => LineAssignmentForm.OperationId = value)
                @FamilySelect("Familia", LineAssignmentForm.ProductFamily, value => LineAssignmentForm.ProductFamily = value)
                <label><span>Linea SMT</span><InputText class="form-control" @bind-Value="LineAssignmentForm.LineCode" /></label>
                <label><span>Numero linea</span><InputNumber class="form-control" @bind-Value="LineAssignmentForm.LineNumber" /></label>
                <label><span>Distribucion %</span><DecimalInput Value="LineAssignmentForm.LineDistributionPercent" ValueChanged="value => LineAssignmentForm.LineDistributionPercent = value ?? 0m" /></label>
                <label><span>Mes</span><InputText class="form-control" @bind-Value="LineAssignmentForm.MonthName" /></label>
                <label><span>Secuencia mes</span><InputNumber class="form-control" @bind-Value="LineAssignmentForm.MonthSequence" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="LineAssignmentForm.IsActive" /> Activa</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetLineAssignment">Nuevo</button>
                    @if (LineAssignmentForm.SmtLineAssignmentId > 0)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="ResetLineAssignment">Cancelar edicion</button>
                    }
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>@SortableLineAssignmentHeader("Escenario", SmtLineAssignmentCatalogSortColumn.ScenarioName)</th><th>@SortableLineAssignmentHeader("Mes/Semana", SmtLineAssignmentCatalogSortColumn.WeekName)</th><th>@SortableLineAssignmentHeader("Operacion", SmtLineAssignmentCatalogSortColumn.OperationCode)</th><th>@SortableLineAssignmentHeader("Familia", SmtLineAssignmentCatalogSortColumn.ProductFamily)</th><th>@SortableLineAssignmentHeader("Linea", SmtLineAssignmentCatalogSortColumn.LineCode)</th><th>@SortableLineAssignmentHeader("No.", SmtLineAssignmentCatalogSortColumn.LineNumber)</th><th>@SortableLineAssignmentHeader("Distribucion", SmtLineAssignmentCatalogSortColumn.LineDistributionPercent)</th><th>@SortableLineAssignmentHeader("Estado", SmtLineAssignmentCatalogSortColumn.IsActive)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in FilteredLineAssignments)
                    {
                        <tr>
                            <td>@item.ScenarioName</td>
                            <td>@item.WeekName</td>
                            <td>@item.OperationCode</td>
                            <td>@item.ProductFamily</td>
                            <td>@item.LineCode</td>
                            <td class="number-cell">@item.LineNumber</td>
                            <td class="number-cell">@DecimalRounding.FormatNatural(item.LineDistributionPercent, "%", decimals: 0)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditLineAssignment(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment OperationCapacitySection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Calendario SMT</h2>
            <span>@FilteredOperationCapacities.Count de @Snapshot!.OperationCapacities.Count registros</span>
        </div>
        <p class="muted-cell">Define los dias, turnos, horas, festivos, overtime y paro planeado que alimentan la capacidad mensual SMT.</p>
        <div class="control-grid">
            <label><span>Buscar en catalogo</span><InputText class="form-control" @bind-Value="OperationCapacitySearchText" /></label>
        </div>
        <EditForm Model="OperationCapacityForm" OnValidSubmit="SaveOperationCapacityAsync">
            <div class="catalog-form">
                @ScenarioSelect(OperationCapacityForm.ScenarioId, SetOperationCapacityScenario)
                @WeekSelect(OperationCapacityForm.ProductionWeekId, OperationCapacityForm.ScenarioId, value => OperationCapacityForm.ProductionWeekId = value)
                @OperationSelect(OperationCapacityForm.OperationId, value => OperationCapacityForm.OperationId = value)
                <label><span>Dias por semana</span><DecimalInput Value="OperationCapacityForm.WorkDays" ValueChanged="value => OperationCapacityForm.WorkDays = value ?? 0m" /></label>
                <label><span>Horas por turno</span><DecimalInput Value="OperationCapacityForm.HoursPerShift" ValueChanged="value => OperationCapacityForm.HoursPerShift = value ?? 0m" /></label>
