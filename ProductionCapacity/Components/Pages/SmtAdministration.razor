        OperationCapacitySortColumn == column ? OperationCapacitySortDirection() : string.Empty;

    private string CapacityTargetSortIndicator(SmtCapacityTargetCatalogSortColumn column) =>
        CapacityTargetSortColumn == column ? CapacityTargetSortDirection() : string.Empty;

    private string AuditSortIndicator(SmtAuditLogSortColumn column) =>
        AuditSortColumn == column ? AuditSortDirection() : string.Empty;

    private string FamilySortDirection() => FamilySortDescending ? "v" : "^";
    private string FamilyRateSortDirection() => FamilyRateSortDescending ? "v" : "^";
    private string LineRateSortDirection() => LineRateSortDescending ? "v" : "^";
    private string LineAssignmentSortDirection() => LineAssignmentSortDescending ? "v" : "^";
    private string OperationCapacitySortDirection() => OperationCapacitySortDescending ? "v" : "^";
    private string CapacityTargetSortDirection() => CapacityTargetSortDescending ? "v" : "^";
    private string AuditSortDirection() => AuditSortDescending ? "v" : "^";
}
