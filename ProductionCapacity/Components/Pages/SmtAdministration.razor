    private async Task SaveFamilyAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveFamilyAsync(FamilyForm);
        ResetFamily();
    }, "Familia SMT guardada.");

    private async Task SaveFamilyRateAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveFamilyRateAsync(FamilyRateForm);
        ResetFamilyRate();
    }, "UPH por familia guardado.");

    private async Task SaveLineRateAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveLineFamilyRateAsync(LineRateForm);
        ResetLineRate();
    }, "UPH por linea guardado.");

    private async Task SaveLineAssignmentAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveLineAssignmentAsync(LineAssignmentForm);
        ResetLineAssignment();
    }, "Distribucion por linea guardada.");

    private async Task SaveOperationCapacityAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveOperationCapacityAsync(OperationCapacityForm);
        ResetOperationCapacity();
    }, "Calendario SMT guardado.");

    private async Task SaveCapacityTargetAsync() => await SaveAsync(async () =>
    {
        await SmtService.SaveCapacityTargetAsync(CapacityTargetForm);
        ResetCapacityTarget();
    }, "Target Capacity SMT guardado.");

    private async Task SaveAsync(Func<Task> saveAction, string successMessage)
    {
        try
        {
            await saveAction();
            await LoadSnapshotAsync();
            StatusClass = "alert-success";
            StatusMessage = successMessage;
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = $"No se pudo guardar: {ex.Message}";
        }
    }

