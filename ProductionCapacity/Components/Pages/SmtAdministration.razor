    private void ResetFamily() => FamilyForm = NewFamily();
    private void ResetFamilyRate() => FamilyRateForm = NewFamilyRate(Snapshot);
    private void ResetLineRate() => LineRateForm = NewLineRate(Snapshot);
    private void ResetLineAssignment() => LineAssignmentForm = NewLineAssignment(Snapshot);
    private void ResetOperationCapacity() => OperationCapacityForm = NewOperationCapacity(Snapshot);
    private void ResetCapacityTarget() => CapacityTargetForm = NewCapacityTarget(Snapshot);

    private int DefaultOperationId() =>
        Snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
        Snapshot?.Operations.FirstOrDefault()?.OperationId ??
        0;

    private string DefaultFamily() =>
        Snapshot?.Families.FirstOrDefault(item => item.IsActive)?.ProductFamily ?? string.Empty;

    private int DefaultScenarioId() =>
        Snapshot?.Scenarios.FirstOrDefault()?.ScenarioId ?? 0;

    private int DefaultWeekId(int scenarioId) =>
        Snapshot?.ProductionWeeks.FirstOrDefault(item => scenarioId == 0 || item.ScenarioId == scenarioId)?.ProductionWeekId ?? 0;

    private void SetLineAssignmentScenario(int scenarioId)
    {
        LineAssignmentForm.ScenarioId = scenarioId;
        LineAssignmentForm.ProductionWeekId = DefaultWeekId(scenarioId);
    }

    private void SetOperationCapacityScenario(int scenarioId)
    {
        OperationCapacityForm.ScenarioId = scenarioId;
        OperationCapacityForm.ProductionWeekId = DefaultWeekId(scenarioId);
    }

    private void SetCapacityTargetScenario(int scenarioId)
    {
        CapacityTargetForm.ScenarioId = scenarioId;
        CapacityTargetForm.ProductionWeekId = DefaultWeekId(scenarioId);
    }

    private static SmtFamilyCatalogItem NewFamily() => new() { IsActive = true };

    private static SmtFamilyRateCatalogItem NewFamilyRate(SmtAdministrationSnapshot? snapshot = null) => new()
    {
        ProductFamily = snapshot?.Families.FirstOrDefault(item => item.IsActive)?.ProductFamily ?? string.Empty,
        OperationId = snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
            snapshot?.Operations.FirstOrDefault()?.OperationId ?? 0,
        IsActive = true
    };

    private static SmtLineFamilyRateCatalogItem NewLineRate(SmtAdministrationSnapshot? snapshot = null) => new()
    {
        ProductFamily = snapshot?.Families.FirstOrDefault(item => item.IsActive)?.ProductFamily ?? string.Empty,
        OperationId = snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
            snapshot?.Operations.FirstOrDefault()?.OperationId ?? 0,
        LineCode = "SMT 1",
        LineNumber = 1,
        IsActive = true
    };

    private static SmtLineAssignmentCatalogItem NewLineAssignment(SmtAdministrationSnapshot? snapshot = null)
    {
        var scenarioId = snapshot?.Scenarios.FirstOrDefault()?.ScenarioId ?? 0;
        return new()
        {
            ScenarioId = scenarioId,
            ProductionWeekId = snapshot?.ProductionWeeks.FirstOrDefault(item => scenarioId == 0 || item.ScenarioId == scenarioId)?.ProductionWeekId ?? 0,
            OperationId = snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
                snapshot?.Operations.FirstOrDefault()?.OperationId ?? 0,
            ProductFamily = snapshot?.Families.FirstOrDefault(item => item.IsActive)?.ProductFamily ?? string.Empty,
            LineCode = "SMT 1",
            LineNumber = 1,
            LineDistributionPercent = 100m,
            MonthName = snapshot?.ProductionWeeks.FirstOrDefault(item => scenarioId == 0 || item.ScenarioId == scenarioId)?.WeekName,
            MonthSequence = 1,
            IsActive = true
        };
    }

    private static SmtOperationCapacityCatalogItem NewOperationCapacity(SmtAdministrationSnapshot? snapshot = null)
    {
        var scenarioId = snapshot?.Scenarios.FirstOrDefault()?.ScenarioId ?? 0;
        return new()
        {
            ScenarioId = scenarioId,
            ProductionWeekId = snapshot?.ProductionWeeks.FirstOrDefault(item => scenarioId == 0 || item.ScenarioId == scenarioId)?.ProductionWeekId ?? 0,
            OperationId = snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
                snapshot?.Operations.FirstOrDefault()?.OperationId ?? 0,
            WorkDays = 5.66m,
            HoursPerShift = 7.5m,
            ShiftsPerDay = 3,
            EquipmentQuantity = 6m
        };
    }

    private static SmtCapacityTargetCatalogItem NewCapacityTarget(SmtAdministrationSnapshot? snapshot = null)
    {
        var scenarioId = snapshot?.Scenarios.FirstOrDefault()?.ScenarioId ?? 0;
        return new()
        {
            ScenarioId = scenarioId,
            ProductionWeekId = snapshot?.ProductionWeeks.FirstOrDefault(item => scenarioId == 0 || item.ScenarioId == scenarioId)?.ProductionWeekId ?? 0,
            OperationId = snapshot?.Operations.FirstOrDefault(item => string.Equals(item.OperationCode, "SMT", StringComparison.OrdinalIgnoreCase))?.OperationId ??
                snapshot?.Operations.FirstOrDefault()?.OperationId ?? 0,
            ProductFamily = snapshot?.Families.FirstOrDefault(item => item.IsActive)?.ProductFamily ?? string.Empty,
            LineCode = "SMT 1"
        };
    }

