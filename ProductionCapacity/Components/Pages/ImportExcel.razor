    private void ClearSelectedFiles()
    {
        PendingPackage = null;
        SelectedCsvCount = 0;
        SelectedFmdFileName = null;
        FileInputKey = Guid.NewGuid();
        FmdFileInputKey = Guid.NewGuid();
    }

    private void StartBusy(string message)
    {
        IsBusy = true;
        BusyMessage = message;
        ImportState = "Procesando";
        StatusClass = "alert-info";
        StatusMessage = message;
        StateHasChanged();
    }

    private void StopBusy()
    {
        IsBusy = false;
    }

    private static bool HasSmtImpact(ExcelCapacityImportPreview preview) =>
        preview.SmtImpact.NewFamilies.Count > 0 ||
        preview.SmtImpact.ExistingFamilies.Count > 0 ||
        preview.SmtImpact.FamilyRateReplacements.Count > 0 ||
        preview.SmtImpact.IncompleteItems.Count > 0;

    private static async Task<ImportDatabaseSnapshot> LoadDatabaseSnapshotAsync(PlanningDbContext db, string label) => new(
        label,
        await db.Scenarios.CountAsync(),
        await db.ProductionWeeks.CountAsync(),
        await db.PartNumbers.CountAsync(),
        await db.WeeklyDemand.CountAsync(),
        await db.Operations.CountAsync(),
        await db.OperationRates.CountAsync(),
        await db.OperationWeeklyCapacities.CountAsync(),
        await db.PartCrossReferences.CountAsync(),
        await db.TestTimeDefinitions.CountAsync(),
        await db.ResourceTypes.CountAsync(),
        await db.ResourceConfigurations.CountAsync(),
        await db.ResourceInventories.CountAsync(),
        await db.SmtFamilies.CountAsync(),
        await db.SmtFamilyVolumes.CountAsync(),
        await db.SmtFamilyRates.CountAsync(),
        await db.SmtLineFamilyRates.CountAsync(),
        await db.SmtLineAssignments.CountAsync(),
        await db.SmtCapacityTargets.CountAsync());

