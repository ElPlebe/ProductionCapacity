        </div>
    </section>;

    private RenderFragment RouteSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Rutas de proceso</h2>
            <span>@Snapshot!.ProcessRoutes.Count registros</span>
        </div>
        <EditForm Model="RouteForm" OnValidSubmit="SaveRouteAsync">
            <div class="catalog-form">
                <label>
                    <span>Producto</span>
                    <InputSelect class="form-control" @bind-Value="RouteForm.PartNumberId">
                        @foreach (var item in Snapshot!.PartNumbers.Where(item => item.IsActive))
                        {
                            <option value="@item.PartNumberId">@item.PartNumber - @item.Description</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Maquina</span>
                    <InputSelect class="form-control" @bind-Value="RouteForm.MachineId">
                        @foreach (var item in Snapshot!.Machines.Where(item => item.IsActive))
                        {
                            <option value="@item.MachineId">@item.MachineName</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Operacion</span><InputText class="form-control" @bind-Value="RouteForm.OperationName" /></label>
                <label><span>Secuencia</span><InputNumber class="form-control" @bind-Value="RouteForm.SequenceNumber" /></label>
                <label><span>Tiempo estandar seg.</span><DecimalInput Value="RouteForm.StandardTimeSeconds" ValueChanged="value => RouteForm.StandardTimeSeconds = value ?? 0m" /></label>
                <label><span>Factor default opcional</span><DecimalInput Value="RouteForm.DefaultUtilizationFactor" ValueChanged="value => RouteForm.DefaultUtilizationFactor = value" AllowNull="true" /></label>
                <label><span>Yield default opcional</span><DecimalInput Value="RouteForm.DefaultYield" ValueChanged="value => RouteForm.DefaultYield = value" AllowNull="true" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="RouteForm.IsCapacityConstrained" /> Restringe capacidad</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetRoute">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Producto</th><th>Maquina</th><th>Operacion</th><th>Sec.</th><th>Std sec.</th><th>Factor</th><th>Yield</th><th>Capacidad</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.ProcessRoutes)
                    {
                        <tr>
                            <td>@item.PartNumber</td>
                            <td>@item.MachineName</td>
                            <td>@item.OperationName</td>
                            <td>@item.SequenceNumber</td>
                            <td>@DecimalRounding.FormatUp(item.StandardTimeSeconds)</td>
                            <td>@FormatOptionalDecimal(item.DefaultUtilizationFactor)</td>
                            <td>@FormatOptionalDecimal(item.DefaultYield)</td>
                            <td>@(item.IsCapacityConstrained ? "Si" : "No")</td>
                            <td><button class="link-button" type="button" @onclick="() => EditRoute(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

