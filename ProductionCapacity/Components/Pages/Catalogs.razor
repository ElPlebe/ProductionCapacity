    private void ResetMachine() => MachineForm = NewMachine();
    private void ResetPart() => PartForm = NewPart();
    private void ResetSubFamily() => SubFamilyForm = NewSubFamily();
    private void ResetRackType() => RackTypeForm = NewRackType();
    private void ResetAccessory() => AccessoryForm = NewAccessory();
    private void ResetRoute() => RouteForm = NewRoute(Snapshot);
    private void ResetRackConfiguration() => RackConfigurationForm = NewRackConfiguration(Snapshot);
    private void ResetCrossReference() => CrossReferenceForm = NewCrossReference(Snapshot);
    private void ResetTestTime() => TestTimeForm = NewTestTime(Snapshot);
    private void ResetResourceType() => ResourceTypeForm = NewResourceType();

    private static MachineCatalogItem NewMachine() => new() { IsActive = true, DefaultUtilizationFactor = 0.80m };
    private static PartNumberCatalogItem NewPart() => new() { IsActive = true, DefaultYield = 1m };
    private static SubFamilyCatalogItem NewSubFamily() => new() { IsActive = true };
    private static RackTypeCatalogItem NewRackType() => new() { IsActive = true, BaseUnitsPerRack = 1m };
    private static RackAccessoryCatalogItem NewAccessory() => new() { IsActive = true };
    private static ProcessRouteCatalogItem NewRoute(CatalogSnapshot? snapshot = null) => new()
    {
        PartNumberId = snapshot?.PartNumbers.FirstOrDefault(item => item.IsActive)?.PartNumberId ?? 0,
        MachineId = snapshot?.Machines.FirstOrDefault(item => item.IsActive)?.MachineId ?? 0,
        SequenceNumber = 1,
        StandardTimeSeconds = 1m,
        IsCapacityConstrained = true
    };
    private static RackConfigurationCatalogItem NewRackConfiguration(CatalogSnapshot? snapshot = null) => new()
    {
        RackTypeId = snapshot?.RackTypes.FirstOrDefault(item => item.IsActive)?.RackTypeId ?? 0,
        PartNumberId = snapshot?.PartNumbers.FirstOrDefault(item => item.IsActive)?.PartNumberId ?? 0,
        MachineId = snapshot?.Machines.FirstOrDefault(item => item.IsActive)?.MachineId ?? 0,
        UnitsPerRack = 1m,
        IsActive = true
    };
    private static PartCrossReferenceCatalogItem NewCrossReference(CatalogSnapshot? snapshot = null) => new()
    {
        PartNumberId = snapshot?.PartNumbers.FirstOrDefault(item => item.IsActive)?.PartNumberId ?? 0,
        ReferenceType = "73_LEVEL"
    };
    private static TestTimeDefinitionCatalogItem NewTestTime(CatalogSnapshot? snapshot = null) => new()
    {
        PartNumberId = snapshot?.PartNumbers.FirstOrDefault(item => item.IsActive)?.PartNumberId ?? 0,
        OperationId = snapshot?.Operations.FirstOrDefault(item => item.IsActive)?.OperationId ?? 0,
        TestName = "TEST",
        QuantityCell = 1m,
        QuantityEquipment = 1m,
        IsActive = true
    };
    private static ResourceTypeCatalogItem NewResourceType() => new() { ResourceKind = "Rack", IsActive = true };

    private string GetTabClass(string key) => key == ActiveTab ? "catalog-tab is-active" : "catalog-tab";
    private IReadOnlyList<SmtFamilyLookupCatalogItem> ActiveSmtFamilies =>
        Snapshot?.SmtFamilies.Where(item => item.IsActive).ToList() ?? [];

    private IReadOnlyList<SubFamilyCatalogItem> ActiveSubFamiliesForPart =>
        string.IsNullOrWhiteSpace(PartForm.ProductFamily) || Snapshot is null
            ? []
            : Snapshot.SubFamilies
                .Where(item => item.IsActive &&
                    string.Equals(item.ProductFamily, PartForm.ProductFamily, StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.SubFamilyName)
                .ToList();

    private static string FormatActive(bool isActive) => isActive ? "Activo" : "Inactivo";
    private static string FormatOptionalDecimal(decimal? value) => DecimalRounding.FormatOptionalUp(value);
}
