@page "/catalogos"
@rendermode InteractiveServer
@inject CatalogAdministrationService CatalogService

<PageTitle>Catalogos</PageTitle>

<section class="planner-shell">
    <div class="planner-header">
        <div>
            <p class="eyebrow">Administracion</p>
            <h1>Catalogos</h1>
        </div>
        <div class="scenario-pill">
            <span>Registros</span>
            <strong>@TotalRecords.ToString("N0")</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @StatusClass" role="alert">
            @StatusMessage
        </div>
    }

    @if (IsLoading)
    {
        <div class="panel">Cargando catalogos...</div>
    }
    else if (Snapshot is null)
    {
        <div class="alert alert-danger">No pude cargar los catalogos.</div>
    }
    else
    {
        <div class="catalog-tabs">
            @foreach (var tab in Tabs)
            {
                <button class="@GetTabClass(tab.Key)" type="button" @onclick="() => ActiveTab = tab.Key">
                    @tab.Label
                </button>
            }
        </div>

        @switch (ActiveTab)
        {
            case "machines":
                @MachineSection()
                break;
            case "parts":
                @PartSection()
                break;
            case "subfamilies":
                @SubFamilySection()
                break;
            case "racks":
                @RackTypeSection()
                break;
            case "accessories":
                @AccessorySection()
                break;
            case "routes":
                @RouteSection()
                break;
            case "rack-configurations":
                @RackConfigurationSection()
                break;
            case "crossrefs":
                @CrossReferenceSection()
                break;
            case "test-times":
                @TestTimeSection()
                break;
            case "resources":
                @ResourceTypeSection()
                break;
        }
    }
</section>

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("machines", "Maquinas"),
        ("parts", "Numeros de parte"),
        ("subfamilies", "Subfamilias"),
        ("racks", "Racks"),
        ("accessories", "Accesorios"),
        ("routes", "Rutas"),
        ("rack-configurations", "Config. racks"),
        ("crossrefs", "Crossrefs"),
        ("test-times", "Tiempos test"),
        ("resources", "Recursos")
    ];

    private bool IsLoading { get; set; } = true;
    private string ActiveTab { get; set; } = "machines";
    private CatalogSnapshot? Snapshot { get; set; }
    private string? StatusMessage { get; set; }
    private string StatusClass { get; set; } = "alert-success";

    private MachineCatalogItem MachineForm { get; set; } = NewMachine();
    private PartNumberCatalogItem PartForm { get; set; } = NewPart();
    private SubFamilyCatalogItem SubFamilyForm { get; set; } = NewSubFamily();
    private RackTypeCatalogItem RackTypeForm { get; set; } = NewRackType();
    private RackAccessoryCatalogItem AccessoryForm { get; set; } = NewAccessory();
    private ProcessRouteCatalogItem RouteForm { get; set; } = NewRoute();
    private RackConfigurationCatalogItem RackConfigurationForm { get; set; } = NewRackConfiguration();
    private PartCrossReferenceCatalogItem CrossReferenceForm { get; set; } = NewCrossReference();
    private TestTimeDefinitionCatalogItem TestTimeForm { get; set; } = NewTestTime();
    private ResourceTypeCatalogItem ResourceTypeForm { get; set; } = NewResourceType();

    private int TotalRecords => Snapshot is null
        ? 0
        : Snapshot.Machines.Count +
          Snapshot.PartNumbers.Count +
          Snapshot.SubFamilies.Count +
          Snapshot.RackTypes.Count +
          Snapshot.RackAccessories.Count +
          Snapshot.ProcessRoutes.Count +
          Snapshot.RackConfigurations.Count +
          Snapshot.PartCrossReferences.Count +
          Snapshot.TestTimeDefinitions.Count +
          Snapshot.ResourceTypes.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadSnapshotAsync();
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = $"No pude cargar los catalogos. Verifica que los scripts 003 y 004 esten aplicados en SQL Server: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadSnapshotAsync()
    {
        Snapshot = await CatalogService.GetSnapshotAsync();

        if (RouteForm.PartNumberId == 0 && Snapshot.PartNumbers.Count > 0)
        {
            RouteForm.PartNumberId = Snapshot.PartNumbers[0].PartNumberId;
        }

        if (RouteForm.MachineId == 0 && Snapshot.Machines.Count > 0)
        {
            RouteForm.MachineId = Snapshot.Machines[0].MachineId;
        }

        if (RackConfigurationForm.PartNumberId == 0 && Snapshot.PartNumbers.Count > 0)
        {
            RackConfigurationForm.PartNumberId = Snapshot.PartNumbers[0].PartNumberId;
        }

        if (RackConfigurationForm.MachineId == 0 && Snapshot.Machines.Count > 0)
        {
            RackConfigurationForm.MachineId = Snapshot.Machines[0].MachineId;
        }

        if (RackConfigurationForm.RackTypeId == 0 && Snapshot.RackTypes.Count > 0)
        {
            RackConfigurationForm.RackTypeId = Snapshot.RackTypes[0].RackTypeId;
        }

        if (CrossReferenceForm.PartNumberId == 0 && Snapshot.PartNumbers.Count > 0)
        {
            CrossReferenceForm.PartNumberId = Snapshot.PartNumbers[0].PartNumberId;
        }

        if (TestTimeForm.PartNumberId == 0 && Snapshot.PartNumbers.Count > 0)
        {
            TestTimeForm.PartNumberId = Snapshot.PartNumbers[0].PartNumberId;
        }

        if (TestTimeForm.OperationId == 0 && Snapshot.Operations.Count > 0)
        {
            TestTimeForm.OperationId = Snapshot.Operations[0].OperationId;
        }
    }

    private RenderFragment MachineSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Maquinas y lineas</h2>
            <span>@Snapshot!.Machines.Count registros</span>
        </div>
        <EditForm Model="MachineForm" OnValidSubmit="SaveMachineAsync">
            <div class="catalog-form">
                <label><span>Codigo</span><InputText class="form-control" @bind-Value="MachineForm.MachineCode" /></label>
                <label><span>Nombre</span><InputText class="form-control" @bind-Value="MachineForm.MachineName" /></label>
                <label><span>Tipo</span><InputText class="form-control" @bind-Value="MachineForm.MachineType" /></label>
                <label><span>Factor utilizacion</span><DecimalInput Value="MachineForm.DefaultUtilizationFactor" ValueChanged="value => MachineForm.DefaultUtilizationFactor = value ?? 0m" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="MachineForm.IsActive" /> Activa</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetMachine">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Codigo</th><th>Nombre</th><th>Tipo</th><th>Factor</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.Machines)
                    {
                        <tr>
                            <td>@item.MachineCode</td>
                            <td>@item.MachineName</td>
                            <td>@item.MachineType</td>
                            <td>@DecimalRounding.FormatUp(item.DefaultUtilizationFactor)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditMachine(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment PartSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Numeros de parte SMT</h2>
            <span>@Snapshot!.PartNumbers.Count registros</span>
        </div>
        @if (ActiveSmtFamilies.Count == 0)
        {
            <div class="alert alert-warning">Primero agrega una familia SMT en Administracion SMT.</div>
        }
        <EditForm Model="PartForm" OnValidSubmit="SavePartAsync">
            <div class="catalog-form">
                <label><span>Num parte</span><InputText class="form-control" @bind-Value="PartForm.PartNumber" /></label>
                <label><span>Descripcion</span><InputText class="form-control" @bind-Value="PartForm.Description" /></label>
                <label><span>BU</span><InputText class="form-control" @bind-Value="PartForm.BusinessUnit" /></label>
                <label>
                    <span>Familia</span>
                    <InputSelect class="form-control" @bind-Value="PartForm.ProductFamily">
                        <option value="">Selecciona familia</option>
                        @foreach (var family in ActiveSmtFamilies)
                        {
                            <option value="@family.ProductFamily">@family.ProductFamily</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Subfamilia</span>
                    <InputSelect class="form-control" @bind-Value="PartForm.SubFamily">
                        <option value="">Selecciona subfamilia</option>
                        @foreach (var subFamily in ActiveSubFamiliesForPart)
                        {
                            <option value="@subFamily.SubFamilyName">@subFamily.SubFamilyName</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Yield default</span><DecimalInput Value="PartForm.DefaultYield" ValueChanged="value => PartForm.DefaultYield = value ?? 0m" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="PartForm.IsActive" /> Activo</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetPart">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Num parte</th><th>Descripcion</th><th>BU</th><th>Familia</th><th>Subfamilia</th><th>Yield</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.PartNumbers)
                    {
                        <tr>
                            <td>@item.PartNumber</td>
                            <td>@item.Description</td>
                            <td>@item.BusinessUnit</td>
                            <td>@item.ProductFamily</td>
                            <td>@item.SubFamily</td>
                            <td>@DecimalRounding.FormatUp(item.DefaultYield)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditPart(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment SubFamilySection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Subfamilias SMT</h2>
            <span>@Snapshot!.SubFamilies.Count registros</span>
        </div>
        @if (ActiveSmtFamilies.Count == 0)
        {
            <div class="alert alert-warning">Primero agrega una familia SMT en Administracion SMT.</div>
        }
        <EditForm Model="SubFamilyForm" OnValidSubmit="SaveSubFamilyAsync">
            <div class="catalog-form">
                <label>
                    <span>Familia</span>
                    <InputSelect class="form-control" @bind-Value="SubFamilyForm.ProductFamily">
                        <option value="">Selecciona familia</option>
                        @foreach (var family in ActiveSmtFamilies)
                        {
                            <option value="@family.ProductFamily">@family.ProductFamily</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Subfamilia</span><InputText class="form-control" @bind-Value="SubFamilyForm.SubFamilyName" /></label>
                <label><span>Notas</span><InputText class="form-control" @bind-Value="SubFamilyForm.Notes" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="SubFamilyForm.IsActive" /> Activa</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetSubFamily">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Familia</th><th>Subfamilia</th><th>Estado</th><th>Notas</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.SubFamilies)
                    {
                        <tr>
                            <td>@item.ProductFamily</td>
                            <td>@item.SubFamilyName</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td>@item.Notes</td>
                            <td><button class="link-button" type="button" @onclick="() => EditSubFamily(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

