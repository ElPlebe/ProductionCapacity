                        @foreach (var item in Snapshot!.RackAccessories.Where(item => item.IsActive))
                        {
                            <option value="@item.RackAccessoryId">@item.AccessoryName</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Producto</span>
                    <InputSelect class="form-control" @bind-Value="RackConfigurationForm.PartNumberId">
