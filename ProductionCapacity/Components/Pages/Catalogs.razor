                        {
                            <option value="@item.PartNumberId">@item.PartNumber - @item.Description</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Maquina</span>
                    <InputSelect class="form-control" @bind-Value="RackConfigurationForm.MachineId">
                        @foreach (var item in Snapshot!.Machines.Where(item => item.IsActive))
                        {
                            <option value="@item.MachineId">@item.MachineName</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Piezas por rack</span><DecimalInput Value="RackConfigurationForm.UnitsPerRack" ValueChanged="value => RackConfigurationForm.UnitsPerRack = value ?? 0m" /></label>
                <label><span>Notas</span><InputText class="form-control" @bind-Value="RackConfigurationForm.Notes" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="RackConfigurationForm.IsActive" /> Activa</label>
