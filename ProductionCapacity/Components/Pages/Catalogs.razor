    private RenderFragment TestTimeSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Tiempos de prueba derivados</h2>
            <span>@Snapshot!.TestTimeDefinitions.Count registros</span>
        </div>
        <EditForm Model="TestTimeForm" OnValidSubmit="SaveTestTimeAsync">
            <div class="catalog-form">
                <label>
                    <span>Producto</span>
                    <InputSelect class="form-control" @bind-Value="TestTimeForm.PartNumberId">
                        @foreach (var item in Snapshot!.PartNumbers.Where(item => item.IsActive))
                        {
                            <option value="@item.PartNumberId">@item.PartNumber</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Operacion</span>
                    <InputSelect class="form-control" @bind-Value="TestTimeForm.OperationId">
                        @foreach (var item in Snapshot!.Operations.Where(item => item.IsActive))
                        {
                            <option value="@item.OperationId">@item.OperationCode</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Test</span><InputText class="form-control" @bind-Value="TestTimeForm.TestName" /></label>
                <label><span>Test min.</span><DecimalInput Value="TestTimeForm.TestTimeMinutes" ValueChanged="value => TestTimeForm.TestTimeMinutes = value ?? 0m" /></label>
                <label><span>Handling min.</span><DecimalInput Value="TestTimeForm.HandlingMinutes" ValueChanged="value => TestTimeForm.HandlingMinutes = value ?? 0m" /></label>
                <label><span>Qty cell</span><DecimalInput Value="TestTimeForm.QuantityCell" ValueChanged="value => TestTimeForm.QuantityCell = value ?? 0m" /></label>
                <label><span>Qty equipo</span><DecimalInput Value="TestTimeForm.QuantityEquipment" ValueChanged="value => TestTimeForm.QuantityEquipment = value ?? 0m" /></label>
                <label><span>Std override seg.</span><DecimalInput Value="TestTimeForm.ManualStandardTimeSeconds" ValueChanged="value => TestTimeForm.ManualStandardTimeSeconds = value" AllowNull="true" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="TestTimeForm.IsActive" /> Activo</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetTestTime">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Producto</th><th>Operacion</th><th>Test</th><th>Test min.</th><th>Handling</th><th>Qty cell</th><th>Qty eq.</th><th>Std calc.</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.TestTimeDefinitions)
                    {
                        <tr>
                            <td>@item.PartNumber</td>
                            <td>@item.OperationCode</td>
                            <td>@item.TestName</td>
                            <td>@DecimalRounding.FormatUp(item.TestTimeMinutes)</td>
                            <td>@DecimalRounding.FormatUp(item.HandlingMinutes)</td>
                            <td>@DecimalRounding.FormatUp(item.QuantityCell)</td>
                            <td>@DecimalRounding.FormatUp(item.QuantityEquipment)</td>
                            <td>@DecimalRounding.FormatUp(item.CalculatedStandardTimeSeconds)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditTestTime(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment ResourceTypeSection() => @<section class="panel catalog-panel">
        <div class="panel-title">
            <h2>Recursos fisicos</h2>
            <span>@Snapshot!.ResourceTypes.Count registros</span>
        </div>
        <EditForm Model="ResourceTypeForm" OnValidSubmit="SaveResourceTypeAsync">
            <div class="catalog-form">
                <label><span>Codigo</span><InputText class="form-control" @bind-Value="ResourceTypeForm.ResourceCode" /></label>
                <label><span>Nombre</span><InputText class="form-control" @bind-Value="ResourceTypeForm.ResourceName" /></label>
                <label><span>Tipo</span><InputText class="form-control" @bind-Value="ResourceTypeForm.ResourceKind" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="ResourceTypeForm.IsActive" /> Activo</label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="ResetResourceType">Nuevo</button>
                </div>
            </div>
        </EditForm>
        <div class="table-wrap">
            <table class="planner-table catalog-table">
                <thead><tr><th>Codigo</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.ResourceTypes)
                    {
                        <tr>
                            <td>@item.ResourceCode</td>
                            <td>@item.ResourceName</td>
                            <td>@item.ResourceKind</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditResourceType(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private async Task SaveMachineAsync() => await SaveAsync(async () =>
    {
        await CatalogService.SaveMachineAsync(MachineForm);
        ResetMachine();
    }, "Maquina guardada.");

    private async Task SavePartAsync() => await SaveAsync(async () =>
