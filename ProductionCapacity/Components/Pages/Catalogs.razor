                <thead><tr><th>Rack</th><th>Accesorio</th><th>Producto</th><th>Maquina</th><th>Pzas/rack</th><th>Estado</th><th>Notas</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.RackConfigurations)
                    {
                        <tr>
                            <td>@item.RackName</td>
                            <td>@(item.AccessoryName ?? "Sin accesorio")</td>
                            <td>@item.PartNumber</td>
                            <td>@item.MachineName</td>
                            <td>@DecimalRounding.FormatUp(item.UnitsPerRack)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td>@item.Notes</td>
                            <td><button class="link-button" type="button" @onclick="() => EditRackConfiguration(item)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

