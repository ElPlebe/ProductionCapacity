                <label><span>Nombre</span><InputText class="form-control" @bind-Value="RackTypeForm.RackName" /></label>
                <label><span>Capacidad base</span><DecimalInput Value="RackTypeForm.BaseUnitsPerRack" ValueChanged="value => RackTypeForm.BaseUnitsPerRack = value ?? 0m" /></label>
                <label class="check-row"><InputCheckbox @bind-Value="RackTypeForm.IsActive" /> Activo</label>
