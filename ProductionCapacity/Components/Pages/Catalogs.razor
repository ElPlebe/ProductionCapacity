            <table class="planner-table catalog-table">
                <thead><tr><th>Codigo</th><th>Nombre</th><th>Capacidad</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Snapshot.RackTypes)
                    {
                        <tr>
                            <td>@item.RackCode</td>
                            <td>@item.RackName</td>
                            <td>@DecimalRounding.FormatUp(item.BaseUnitsPerRack)</td>
                            <td>@FormatActive(item.IsActive)</td>
                            <td><button class="link-button" type="button" @onclick="() => EditRackType(item)">Editar</button></td>
                        </tr>
